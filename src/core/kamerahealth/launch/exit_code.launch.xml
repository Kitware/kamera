<?xml version="1.0" encoding="UTF-8"?>
<launch>
  <arg name="system_name" default="nuvo0"/>
  <arg name="sys_namespace" default="/$(var system_name)"/>
  <arg name="exit_code" default="0"/>
  <arg name="spin" default="false"/>

  <node name="exit_code_node" pkg="kamerahealth" exec="exit_code_node"
        namespace="$(var sys_namespace)" output="screen">
    <param name="exit_code" value="$(var exit_code)"/>
    <param name="spin" value="$(var spin)"/>
  </node>
</launch>
