<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>roskv</name>
  <version>1.0.0</version>
  <description>An abstract key-value store for multiple KV backends (Redis-backed)</description>

  <maintainer email="adam.romlein@kitware.com">Adam Romlein</maintainer>
  <author email="michael.mcdermott@kitware.com">Michael McDermott</author>
  <license>Apache 2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>

  <build_depend>nlohmann-json-dev</build_depend>

  <exec_depend>python3-redis</exec_depend>
  <exec_depend>python3-yaml</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
