<?xml version="1.0" encoding="UTF-8"?>
<launch>
  <arg name="system_name" default="nuvo0"/>
  <arg name="cameratype" default="ir"/>
  <arg name="cam_fov" default="no_fov"/>
  <arg name="namespace" default="/$(var system_name)/$(var cameratype)"/>

  <arg name="node_name_suffix" default=""/>
  <!-- Verbosity level for logging. 0=all info silent -->
  <arg name="info_verbosity" default="0"/>

  <!-- Firmware mode (pixel encoding): { mono8, mono16 } -->
  <arg name="firmware_mode" default="mono16"/>
  <!-- Trigger signal source: { Internal, External, Software, IRIG } -->
  <arg name="trigger_source" default="External"/>
  <!-- Scaling format: { Radiometric, TemperatureLinear100mK, TemperatureLinear10mK } -->
  <arg name="ir_format" default="TemperatureLinear10mK"/>

  <!-- Frame sync source: { Internal, External, Video } -->
  <arg name="frame_sync_source" default="External"/>
  <!-- FLIR camera model type: { 6750, 6xx } -->
  <arg name="cam_type" default="6750"/>
  <!-- Connect by serial number, IP address, manufacturer name, or username -->
  <arg name="camera_serial" default=""/>
  <arg name="camera_ipv4" default=""/>
  <arg name="camera_username" default=""/>
  <arg name="camera_manufacturer" default=""/>
  <arg name="camera_mac" default=""/>

  <!-- Optional XML features file; blank retrieves from the camera -->
  <arg name="xmlFeatures_filepath" default=""/>
  <arg name="xmlFeatures_autoBrightness" default="false"/>
  <arg name="xmlFeatures_autoBrightnessTarget" default="128"/>
  <arg name="xmlFeatures_BalanceWhiteAuto" default="0"/>
  <arg name="imageTransfer_numImageBuffers" default="1"/>
  <arg name="nextImage_timeout" default="1000"/>
  <arg name="output_image_crop_top_row" default="-1"/>
  <arg name="output_image_crop_bot_row" default="-1"/>
  <arg name="frame_id" default="/$(var cam_fov)/$(var cameratype)"/>
  <arg name="output_topic_raw" default="image_raw"/>
  <arg name="output_topic_debayer" default=""/>
  <!-- Framerate to access images from the camera -->
  <arg name="output_frame_rate" default="3.0"/>

  <arg name="respawn" default="false"/>

  <node pkg="kw_genicam_driver" exec="a6750_driver_node"
        name="kw_genicam_a6750_driver_node$(var node_name_suffix)"
        namespace="$(var namespace)" output="screen" respawn="$(var respawn)">
    <param name="info_verbosity" value="$(var info_verbosity)"/>

    <param name="firmware_mode" value="$(var firmware_mode)"/>
    <param name="trigger_source" value="$(var trigger_source)"/>
    <param name="ir_format" value="$(var ir_format)"/>

    <param name="frame_sync_source" value="$(var frame_sync_source)"/>
    <param name="cam_type" value="$(var cam_type)"/>

    <param name="camera_serial" value="$(var camera_serial)"/>
    <param name="camera_ip_addr" value="$(var camera_ipv4)"/>
    <param name="camera_username" value="$(var camera_username)"/>
    <param name="camera_manufacturer" value="$(var camera_manufacturer)"/>
    <param name="camera_mac" value="$(var camera_mac)"/>

    <param name="xmlFeatures_filepath" value="$(var xmlFeatures_filepath)"/>
    <param name="xmlFeatures_autoBrightness" value="$(var xmlFeatures_autoBrightness)"/>
    <param name="xmlFeatures_autoBrightnessTarget" value="$(var xmlFeatures_autoBrightnessTarget)"/>
    <param name="xmlFeatures_BalanceWhiteAuto" value="$(var xmlFeatures_BalanceWhiteAuto)"/>
    <param name="imageTransfer_numImageBuffers" value="$(var imageTransfer_numImageBuffers)"/>
    <param name="nextImage_timeout" value="$(var nextImage_timeout)"/>
    <param name="output_image_crop_top_row" value="$(var output_image_crop_top_row)"/>
    <param name="output_image_crop_bot_row" value="$(var output_image_crop_bot_row)"/>
    <param name="frame_id" value="$(var frame_id)"/>
    <param name="output_topic_raw" value="$(var output_topic_raw)"/>
    <param name="output_topic_debayer" value="$(var output_topic_debayer)"/>
    <param name="output_frame_rate" value="$(var output_frame_rate)"/>
  </node>
</launch>
